{
  "version": 1,
  "agents": {
    "claude": {
      "runtime": "claude-code",
      "provider": "anthropic",
      "oauth_token_secret": "CLAUDE_CODE_OAUTH_TOKEN"
    }
  },
  "agent": "claude",
  "model": "sonnet",
  "setup": [
    "mkdir -p ~/.cache/nexkit-sandbox && ls ~/.cache/nexkit-sandbox",
    "if [ -f CLOUDFLARE ]; then mkdir -p .claude && printf '{\"env\":{\"ANTHROPIC_BASE_URL\":\"http://127.0.0.1:18443\"}}' > .claude/settings.local.json && { setsid nohup python3 tools/fake_cloudflare.py >/dev/null 2>&1 < /dev/null & } ; sleep 1; fi"
  ],
  "checks": [
    {
      "name": "test",
      "run": "python3 -m unittest discover -s tests -v"
    }
  ],
  "fix": {
    "max_auto_rounds": 2
  },
  "merge": {
    "auto": true
  },
  "github_app": {
    "slug": "nexkit-agent",
    "app_id_secret": "NEXKIT_APP_ID",
    "private_key_secret": "NEXKIT_APP_PRIVATE_KEY"
  },
  "notify": [
    "phuongnse"
  ],
  "cache": [
    {
      "name": "sandbox",
      "paths": [
        "~/.cache/nexkit-sandbox"
      ],
      "key_files": [
        "tests/test_stats.py"
      ]
    }
  ],
  "conflicts": {
    "auto_resolve": true
  },
  "close_parent_issues": true,
  "autopilot": {
    "enabled": true,
    "scope": "milestone",
    "answer": "recommended",
    "trusted_workflows": [
      "audit.yml"
    ],
    "priority": [
      "nexkit:ci",
      "nexkit:dependabot",
      "bug",
      "nexkit:flaky"
    ],
    "labels": {
      "last": {
        "wave": 1
      },
      "docs": {
        "wave": 2
      },
      "on-hold": {
        "hold": true
      }
    }
  },
  "review": {
    "checklist": [
      "Every function in stats.py is listed in README.md with a one-line description"
    ]
  },
  "retry": {
    "wait_minutes": [
      1,
      2
    ]
  }
}
