{
  "version": 1,
  "agents": {
    "claude": {
      "runtime": "claude-code",
      "provider": "anthropic",
      "oauth_token_secret": "CLAUDE_CODE_OAUTH_TOKEN"
    }
  },
  "agent": "claude",
  "model": "sonnet",
  "setup": [
    "mkdir -p ~/.cache/nexkit-sandbox && ls ~/.cache/nexkit-sandbox"
  ],
  "parallel_checks": true,
  "checks": [
    {
      "name": "test",
      "run": "python3 -m unittest discover -s tests -v",
      "group": "fast"
    },
    {
      "name": "compile",
      "run": "python3 -m py_compile stats.py",
      "group": "fast"
    },
    {
      "name": "slow",
      "run": "sleep 45 && echo slow done"
    },
    {
      "name": "fail",
      "run": "echo 'a deliberate failure, to see it in the summary'; exit 1"
    }
  ],
  "fix": {
    "max_auto_rounds": 2
  },
  "merge": {
    "auto": true
  },
  "github_app": {
    "slug": "nexkit-agent",
    "app_id_secret": "NEXKIT_APP_ID",
    "private_key_secret": "NEXKIT_APP_PRIVATE_KEY"
  },
  "notify": [
    "phuongnse"
  ],
  "cache": [
    {
      "name": "sandbox",
      "paths": [
        "~/.cache/nexkit-sandbox"
      ],
      "key_files": [
        "tests/test_stats.py"
      ]
    }
  ],
  "conflicts": {
    "auto_resolve": true
  },
  "close_parent_issues": true,
  "autopilot": {
    "enabled": true,
    "scope": "milestone",
    "answer": "recommended",
    "trusted_workflows": [
      "audit.yml"
    ],
    "priority": [
      "nexkit:ci",
      "nexkit:dependabot",
      "bug",
      "nexkit:flaky"
    ],
    "labels": {
      "last": {
        "wave": 1
      },
      "docs": {
        "wave": 2
      },
      "on-hold": {
        "hold": true
      }
    }
  },
  "review": {
    "checklist": [
      "Every function in stats.py is listed in README.md with a one-line description"
    ]
  }
}
