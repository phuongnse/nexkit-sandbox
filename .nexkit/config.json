{
  "version": 1,
  "agents": {
    "claude": {
      "runtime": "claude-code",
      "provider": "anthropic",
      "oauth_token_secret": "CLAUDE_CODE_OAUTH_TOKEN"
    }
  },
  "agent": "claude",
  "model": "sonnet",
  "setup": [
    "mkdir -p ~/.cache/nexkit-sandbox && ls ~/.cache/nexkit-sandbox"
  ],
  "checks": [
    {
      "name": "test",
      "run": "python3 -m unittest discover -s tests -v"
    }
  ],
  "fix": {
    "max_auto_rounds": 2
  },
  "merge": {
    "auto": false
  },
  "github_app": {
    "slug": "nexkit-agent",
    "app_id_secret": "NEXKIT_APP_ID",
    "private_key_secret": "NEXKIT_APP_PRIVATE_KEY"
  },
  "notify": [
    "phuongnse"
  ],
  "cache": [
    {
      "name": "sandbox",
      "paths": [
        "~/.cache/nexkit-sandbox"
      ],
      "key_files": [
        "tests/test_stats.py"
      ]
    }
  ]
}
