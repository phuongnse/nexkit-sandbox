{
  "version": 1,
  "agents": {
    "claude": {
      "runtime": "claude-code",
      "provider": "anthropic",
      "oauth_token_secret": "CLAUDE_CODE_OAUTH_TOKEN"
    }
  },
  "agent": "claude",
  "model": "sonnet",
  "setup": [
    "mkdir -p ~/.cache/nexkit-sandbox && ls ~/.cache/nexkit-sandbox"
  ],
  "checks": [
    {
      "name": "test",
      "run": "python3 -m unittest discover -s tests -v"
    }
  ],
  "fix": {
    "max_auto_rounds": 2
  },
  "merge": {
    "auto": true
  },
  "github_app": {
    "slug": "nexkit-agent",
    "app_id_secret": "NEXKIT_APP_ID",
    "private_key_secret": "NEXKIT_APP_PRIVATE_KEY"
  },
  "notify": [
    "phuongnse"
  ],
  "cache": [
    {
      "name": "sandbox",
      "paths": [
        "~/.cache/nexkit-sandbox"
      ],
      "key_files": [
        "tests/test_stats.py"
      ]
    }
  ],
  "conflicts": {
    "auto_resolve": true
  },
  "close_parent_issues": true,
  "autopilot": {
    "enabled": true,
    "scope": "milestone",
    "answer": "recommended",
    "trusted_workflows": [
      "audit.yml"
    ],
    "priority": [
      "nexkit:ci",
      "nexkit:dependabot",
      "bug",
      "nexkit:flaky"
    ],
    "labels": {
      "last": {
        "wave": 1
      },
      "docs": {
        "wave": 2
      },
      "on-hold": {
        "hold": true
      }
    }
  },
  "review": {
    "checklist": [
      "Every function in stats.py is listed in README.md with a one-line description",
      {
        "text": "The change adds no new module file: every function lives in stats.py, as the README's Functions list shows, so that the package stays a single module that one import loads, and callers never need to learn about another file to use it.",
        "person": true
      },
      {
        "text": "Every public function stays pure: it reads no file, no environment variable and no clock, and writes nothing anywhere, so that each result depends only on its arguments, as callers rely on when they cache results or run them in parallel.",
        "person": true
      }
    ]
  }
}
